LOGIN REQUEST
     │
     ▼
┌──────────────┐
│  SELECT      │
│  user.role   │  ←─ nausicaa_dev."user" table
│  FROM user   │
└──────┬───────┘
       │ role = 'admin'
       ├─────────> ADMIN DASHBOARD
       │             │
       └─────────> USER DASHBOARD
                     │
                     ▼
              ┌─────────────┐
              │  GRANTS     │  ←─ nausicaa_dev.grant table
              │   LIST      │
              └─────────────┘

